@model LoginViewModel

@{
    ViewData["Title"] = "登入";
}

<div class="auth-page mx-auto">
    <div class="mb-4">
        <p class="text-success fw-semibold mb-1">Account</p>
        <h1 class="fw-bold mb-1">登入系統</h1>
        <p class="text-muted mb-0">測試帳號：admin / 1234，或 user / 1234。</p>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
            <form asp-action="Login" method="post" class="row g-3">
                <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="col-12">
                    <label asp-for="UserName" class="form-label fw-semibold"></label>
                    <input asp-for="UserName" class="form-control" autocomplete="username" />
                    <span asp-validation-for="UserName" class="text-danger small"></span>
                </div>

                <div class="col-12">
                    <label asp-for="Password" class="form-label fw-semibold"></label>
                    <input asp-for="Password" class="form-control" autocomplete="current-password" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="col-12 d-grid pt-2">
                    <button type="submit" class="btn btn-success">登入</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
