@model FridgeSystem.Models.RegisterViewModel

@{
    ViewData["Title"] = "註冊";
}

<div class="auth-page mx-auto">
    <div class="mb-4">
        <p class="text-success fw-semibold mb-1">Account</p>
        <h1 class="fw-bold mb-1">註冊帳號</h1>
        <p class="text-muted mb-0">註冊後即可登入使用智慧冰箱系統。</p>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
            <form asp-action="Register" method="post" class="row g-3">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="col-12">
                    <label asp-for="UserName" class="form-label fw-semibold"></label>
                    <input asp-for="UserName" class="form-control" />
                    <span asp-validation-for="UserName" class="text-danger small"></span>
                </div>

                <div class="col-12">
                    <label asp-for="Password" class="form-label fw-semibold"></label>
                    <input asp-for="Password" class="form-control" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="col-12">
                    <label asp-for="ConfirmPassword" class="form-label fw-semibold"></label>
                    <input asp-for="ConfirmPassword" class="form-control" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>

                <div class="col-12 d-grid pt-2">
                    <button type="submit" class="btn btn-success">註冊</button>
                </div>

                <div class="col-12 text-center">
                    <a asp-controller="Account" asp-action="Login">已有帳號？前往登入</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}