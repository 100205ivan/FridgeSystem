@model FoodItem

@{
    ViewData["Title"] = "刪除食材";
}

<div class="form-page mx-auto">
    <div class="mb-4">
        <h1 class="fw-bold mb-1">刪除食材</h1>
        <p class="text-muted mb-0">請確認是否要刪除此筆食材資料。</p>
    </div>

    <div class="card border-danger-subtle shadow-sm">
        <div class="card-body p-4">
            <h4 class="fw-bold">@Model.Name</h4>
            <p class="text-muted">@Model.Category · @Model.Quantity · @Model.StoragePlace</p>
            <p class="mb-0">有效期限：@Model.ExpireDate?.ToString("yyyy/MM/dd")</p>
        </div>
    </div>

    <form asp-action="Delete" method="post" class="d-flex justify-content-end gap-2 mt-4">
        <input type="hidden" asp-for="Id" />
        <a asp-action="Index" class="btn btn-outline-secondary">返回列表</a>
        <button type="submit" class="btn btn-danger">確認刪除</button>
    </form>
</div>
